# --- Versions des images (verifier les tags disponibles sur Docker Hub) ---
# Garage doit etre >= v2.0.0 : garage-webui utilise l'API admin v2.
GARAGE_VERSION=v2.3.0
GARAGE_WEBUI_VERSION=1.1.0

# --- Ports hote (modifier ici en cas de conflit) ---
# API S3
GARAGE_S3_PORT=3900
# API admin (health / metrics)
GARAGE_ADMIN_PORT=3903
# Interface web = equivalent de la page NameNode :9870
GARAGE_WEBUI_PORT=3909